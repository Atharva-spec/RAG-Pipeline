# PostgreSQL + pgvector Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_TABLE=document_chunks

# HuggingFace Hub Authentication
HF_TOKEN=

# LLM Backend & Generation Settings
LLM_BACKEND=groq
LLM_TEMPERATURE=0.2

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Speech-to-text query input (browser records audio; API transcribes it)
STT_ENABLED=true
STT_BACKEND=groq
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_MAX_FILE_SIZE_BYTES=26214400
STT_DEFAULT_LANGUAGE=en

# Performance Optimization Flags
USE_ONNX_RERANKER=true
FAST_QUERY_CONDENSER=true

# Automatic document-folder synchronization
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=2.0
