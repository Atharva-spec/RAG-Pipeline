OLLAMA_BASE_URL=http://localhost:11434
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
HF_TOKEN=

# LLM Backend: "ollama" (default local) or "groq"
LLM_BACKEND=ollama
LLM_MODEL=llama3.2

# Groq API configuration (optional high-speed cloud fallback/primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Performance Flags
USE_ONNX_RERANKER=true
FAST_QUERY_CONDENSER=true

